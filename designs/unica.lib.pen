          "id": "Srmmp",
          "name": "Badge master scope",
          "fill": "$--color-stroke-neutral-high",
          "content": "DRAFT · soft / neutral / m / plain / static · compact 20 / 24 / 28 px; no focus padding in the component footprint",
          "fontFamily": "Roboto",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "QJ2Nm",
          "name": "Badge editing notes",
          "fill": "$--color-stroke-neutral-high",
          "content": "Own badge* theme axes preserve the four-material contract. Native action focus is a specimen wrapper.\nCapped text is a labelled static projection: full input stays in Label; recalculate text capacity after changing content or typography.",
          "lineHeight": 1.5,
          "fontFamily": "Roboto",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
