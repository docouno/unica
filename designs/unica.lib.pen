          "content": "Target 3-family theme matrix · soft-*, frost-* & pixel-*",
          "fontFamily": "Roboto",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "i9qBgO",
          "name": "Editing guidance",
          "fill": "$--color-stroke-neutral-high",
          "content": "Use connected instances. Theme axes: appearance / intent / state / size / spacing.\nChange shared paint here; override label and icon content on instances.\nThe 4 px outer reserve exists only to retain the full static focus contour.",
          "lineHeight": 1.5,
          "fontFamily": "Roboto",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Ed3LE",
          "name": "Material limits",
          "fill": "$--color-stroke-neutral",
          "content": "Loading is frozen. Glass saturation and lamp shadow spread are renderer approximations.\nNo keyboard, native form, motion or accessibility behaviour is certified by this canvas.",
          "lineHeight": 1.5,
          "fontFamily": "Roboto",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
