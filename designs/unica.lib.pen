{
  "version": "2.21",
  "children": [
    {
      "type": "frame",
      "id": "hyobJ",
      "x": 0,
      "y": 0,
      "name": "Unica / Button · draft library",
      "theme": {
        "appearance": "solid",
        "intent": "primary",
        "state": "rest",
        "size": "s",
        "spacing": "regular"
      },
      "width": 1120,
      "fill": "$--color-app",
      "layout": "vertical",
      "gap": 24,
      "padding": 48,
      "children": [
        {
          "type": "text",
          "id": "l94Ppz",
          "name": "Library title",
          "fill": "$--color-stroke-neutral-highest",
          "content": "Unica / Button",
          "fontFamily": "Roboto",
          "fontSize": 36,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "QPjGH",
          "name": "Button",
          "theme": {
            "appearance": "solid",
            "intent": "primary",
            "state": "rest",
            "size": "m",
            "spacing": "regular"
          },
          "reusable": true,
          "cornerRadius": [
            "$button/focus-radius",
            "$button/focus-radius",
            "$button/focus-bottom-radius",
            "$button/focus-bottom-radius"
          ],
          "stroke": "$button/focus",
          "strokeWidth": 2,
          "strokeAlignment": "inner",
          "effect": [
            {
              "type": "shadow",
              "shadowType": "outer",
              "color": "$button/shadow-0-color",
              "offset": {
                "x": "$button/shadow-0-x",
                "y": "$button/shadow-0-y"
              },
              "blur": "$button/shadow-0-blur"
            },
            {
              "type": "shadow",
              "shadowType": "outer",
              "enabled": "$button/non-glass",
              "color": "$button/shadow-1-color",
              "offset": {
                "x": "$button/shadow-1-x",
                "y": "$button/shadow-1-y"
              },
              "blur": "$button/shadow-1-blur"
            },
            {
              "type": "shadow",
              "shadowType": "outer",
              "color": "$button/shadow-2-color",
              "offset": {
                "x": "$button/shadow-2-x",
                "y": "$button/shadow-2-y"
              },
              "blur": "$button/shadow-2-blur"
            }
          ],
          "padding": [
            "$button/reserve-top",
            "$button/reserve-right",
            "$button/reserve-bottom",
            "$button/reserve-left"
          ],
          "justifyContent": "center",
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "TVgf2",
              "name": "Material",
              "clip": "$button/loading",
              "fill": [
                "$button/fill",
                {
                  "type": "gradient",
                  "gradientType": "linear",
                  "enabled": "$button/lamp",
                  "rotation": 225,
                  "size": {
                    "height": 1
                  },
                  "colors": [
                    {
                      "color": "$button/volume-0",
                      "position": 0
                    },
                    {
                      "color": "$button/volume-1",
                      "position": 0.5
                    },
                    {
                      "color": "$button/volume-2",
                      "position": 1
                    }
                  ]
                },
                {
                  "type": "image",
                  "enabled": "$button/glass",
                  "url": "assets/button-glass-noise.png",
                  "mode": "stretch"
                },
                {
                  "type": "shader",
                  "enabled": "$button/lamp-sheen",
                  "url": "assets/button-lamp-sheen.glsl",
                  "uniforms": {
                    "u_dome": "$theme/button/lamp-dome",
                    "u_hotspot": "$theme/button/lamp-hotspot",
                    "u_topRim": "$theme/button/lamp-rim",
                    "u_bottomShade": "$theme/button/lamp-shade",
                    "u_radius": "$button/radius"
                  }
                },
                {
                  "type": "shader",
                  "enabled": "$button/loading",
                  "url": "assets/button-loading-stripe.glsl",
                  "uniforms": {
                    "u_stripeColor": "$button/stripe"
                  }
                }
              ],
              "cornerRadius": [
                "$button/radius",
                "$button/radius",
                "$button/bottom-radius",
                "$button/bottom-radius"
              ],
              "stroke": "$button/edge",
              "strokeWidth": {
                "top": "$button/edge-x",
                "right": "$button/edge-x",
                "bottom": "$button/edge-y",
                "left": "$button/edge-x"
              },
              "strokeAlignment": "inner",
              "effect": [
                {
                  "type": "background_blur",
                  "radius": 10,
                  "enabled": "$button/glass"
                },
                {
                  "type": "shadow",
                  "shadowType": "inner",
                  "enabled": "$button/glass",
                  "color": "$button/shadow-1-color",
                  "offset": {
                    "x": "$button/shadow-1-x",
                    "y": "$button/shadow-1-y"
                  },
                  "blur": "$button/shadow-1-blur"
                }
              ],
              "padding": [
                "$button/padding-y",
                "$button/padding-x"
              ],
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                {
                  "type": "text",
                  "id": "ZIKQE",
                  "name": "Height strut",
                  "fill": "#00000000",
                  "content": "​",
                  "lineHeight": "$button/line",
