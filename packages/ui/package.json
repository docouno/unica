{
  "name": "@docouno/unica",
  "version": "0.1.0",
  "description": "Role-based React 19 design system with Soft, Frost, and Pixel themes",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docouno/unica.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "engines": {
    "node": "^24.22.1"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "check": "devkit-verify && npm run format:check && npm run lint && npm run typecheck",
    "format:check": "prettier --check . \"!package.json\" \"!package-lock.json\" \"!dist/**\" \"!release/**\" \"!coverage/**\"",
    "format": "prettier --write . \"!package.json\" \"!package-lock.json\" \"!dist/**\" \"!release/**\" \"!coverage/**\"",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "fix": "npm run format && eslint --max-warnings 0 --fix . && npm run format",
    "test": "vitest run --config vitest.config.mjs",
    "build": "tsdown && node scripts/verify-dist-css.mjs && devkit-verify --pack && node --conditions=react-server --input-type=module -e \"import { THEME_PRESETS, defineGlyph, getUnicaRootProps } from '@docouno/unica'; if (!THEME_PRESETS.length || !defineGlyph(() => null)['~unica.glyph'] || getUnicaRootProps({ theme: 'frost-dark' })['data-theme'] !== 'frost-dark' || Object.keys(getUnicaRootProps()).length !== 0) process.exit(1)\"",
    "package": "devkit-pack"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@docouno/env": "0.5.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@tsdown/css": "0.23.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "lightningcss": "1.33.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "devkit": {
    "sourceDirectories": [
      "src",
      "test"
    ],
    "typecheckConfigs": [
      "tsconfig.json",
      "tsconfig.test.json"
    ],
    "boundaries": {
      "forbidCrossAppImports": true
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  }
}
